{
  "name": "zernix-dungeon-assistant",
  "version": "1.0.0",
  "main": "electron/main.cjs", 
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.zernix.assistant",
    "productName": "ZERNIX Dungeon Assistant",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "*.mjs",
      "srd.db"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^latest",
    "electron-builder": "^latest",
    "vite": "^latest"
  }
}